\newcommand{\chip}[1]{%
  \tcbox[on line,colback=BlueSoft,colframe=BrandBlue!18,boxrule=0.35pt,arc=2mm,
  left=1.4mm,right=1.4mm,top=0.45mm,bottom=0.45mm]
  {\scriptsize\bfseries\textcolor{BrandBlueDark}{#1}}%
}

\newcommand{\coverHeader}[2]{%
  \begingroup
    {\scriptsize\bfseries\textcolor{BrandBlueDark}{Lecci\'on \LessonCode\ \textperiodcentered\ \LessonVersion}}\hfill
    {\scriptsize\textcolor{Muted}{1.\textordmasculine\ Bachillerato}}\par\vspace{0.42em}
    {\LARGE\bfseries\textcolor{Ink}{#1}}\par
    {\normalsize\textcolor{Muted}{#2}}\par
    \vspace{0.4em}{\color{BrandBlue}\hrule height 0.8pt}\vspace{0.5em}
  \endgroup
}

\newcommand{\lessonHeader}[4]{%
  \begin{tcolorbox}[enhanced,colback=white,colframe=Border,boxrule=0.5pt,arc=3mm,
    left=3mm,right=3mm,top=2.4mm,bottom=2.4mm,borderline west={2.2pt}{0pt}{BrandBlue}]
    \chip{#1}\hfill{\scriptsize\textcolor{Muted}{#2}}\par\vspace{0.25em}
    {\Large\bfseries\textcolor{Ink}{#3}}\par
    {\small\textcolor{Muted}{#4}}
  \end{tcolorbox}
}

\newtcolorbox{lessoncard}[2][]{enhanced,breakable,colback=white,colframe=white,boxrule=0pt,arc=0mm,
  left=2.6mm,right=2.6mm,top=2mm,bottom=2mm,title={#2},
  fonttitle=\bfseries\small\color{BrandBlueDark},coltitle=BrandBlueDark,colbacktitle=white,
  attach boxed title to top left={xshift=2mm,yshift=-2mm},
  boxed title style={boxrule=0pt,colback=white,arc=2mm,left=1.2mm,right=1.2mm,top=0.5mm,bottom=0.5mm},#1}

